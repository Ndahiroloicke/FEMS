generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  INSPECTOR
  USER
}

enum ExtinguisherType {
  WATER
  CO2
  FOAM
  DRY_CHEMICAL
}

enum ExtinguisherStatus {
  ACTIVE
  EXPIRED
  NEEDS_MAINTENANCE
  OUT_OF_SERVICE
}

enum InspectionStatus {
  PENDING
  APPROVED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  OVERDUE
}

enum MaintenanceCondition {
  GOOD
  FAIR
  POOR
  DAMAGED
  NEEDS_REPLACEMENT
}

enum NotificationType {
  INSPECTION_SCHEDULED
  INSPECTION_REMINDER
  EXPIRY_WARNING
  MAINTENANCE_LOGGED
  ACCOUNT
}

enum NotificationChannel {
  EMAIL
  SYSTEM
}

model User {
  id String @id @default(uuid())
  firstName String
  lastName String
  email String @unique
  passwordHash String
  role Role @default(USER)
  isActive Boolean @default(true)
  resetToken String?
  resetTokenExpiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  scheduledInspections Inspection[] @relation("ScheduledBy")
  assignedInspections Inspection[] @relation("Inspector")
  maintenanceLogs MaintenanceLog[]
  notifications Notification[]
  ownedExtinguishers FireExtinguisher[] @relation("OwnedExtinguishers")
  @@map("users")
}

model FireExtinguisher {
  id String @id @default(uuid())
  serialNumber String @unique
  location String
  type ExtinguisherType
  size String
  installationDate DateTime
  expiryDate DateTime
  status ExtinguisherStatus @default(ACTIVE)
  ownerId String?
  owner User? @relation("OwnedExtinguishers", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  inspections Inspection[]
  maintenanceLogs MaintenanceLog[]
  notifications Notification[]
  @@map("fire_extinguishers")
}

model Inspection {
  id String @id @default(uuid())
  extinguisherId String
  extinguisher FireExtinguisher @relation(fields: [extinguisherId], references: [id], onDelete: Cascade)
  scheduledById String
  scheduledBy User @relation("ScheduledBy", fields: [scheduledById], references: [id])
  inspectorId String?
  inspector User? @relation("Inspector", fields: [inspectorId], references: [id])
  scheduledAt DateTime
  status InspectionStatus @default(SCHEDULED)
  result String?
  notes String?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  maintenanceLogs MaintenanceLog[]
  @@map("inspections")
}

model MaintenanceLog {
  id String @id @default(uuid())
  extinguisherId String
  extinguisher FireExtinguisher @relation(fields: [extinguisherId], references: [id], onDelete: Cascade)
  inspectorId String
  inspector User @relation(fields: [inspectorId], references: [id])
  inspectionId String?
  inspection Inspection? @relation(fields: [inspectionId], references: [id])
  actionsTaken String
  conditionNoted MaintenanceCondition
  actionDate DateTime
  createdAt DateTime @default(now())
  @@map("maintenance_logs")
}

model Notification {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  extinguisherId String?
  extinguisher FireExtinguisher? @relation(fields: [extinguisherId], references: [id], onDelete: SetNull)
  type NotificationType
  channel NotificationChannel @default(SYSTEM)
  message String
  isRead Boolean @default(false)
  sentAt DateTime @default(now())
  @@map("notifications")
}
