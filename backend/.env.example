# PostgreSQL connection — point this at your local or hosted Postgres instance
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fire_extinguisher?schema=public"

# Server
PORT=3001
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000

# Auth / JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d

# Scheduled jobs
EXPIRY_WARNING_DAYS=30

# SMTP (optional — if SMTP_HOST is unset, emails are logged to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@fems.local
