

Table customers {
  id varchar [primary key, note: 'UUID']
  full_name varchar [not null]
  national_id varchar [unique, not null, note: 'Government ID number']
  email varchar [note: 'Optional contact email']
  phone varchar [not null]
  address varchar
  created_at timestamp [default: `now()`]
  updated_at timestamp [not null]
}

Table fire_extinguishers {
  id varchar [primary key, note: 'UUID']
  serial_number varchar [unique, not null]
  type varchar [note: 'e.g. ABC Dry Powder']
  capacity varchar [note: 'e.g. 6kg']
  purchase_date timestamp [not null]
  expiry_date timestamp [not null]
  status varchar [not null, default: 'ACTIVE', note: 'ACTIVE | DELIVERED | RETURNED | EXPIRED']
  customer_id varchar [not null]
  created_at timestamp [default: `now()`]
  updated_at timestamp [not null]
}

Table notifications {
  id varchar [primary key, note: 'UUID']
  type varchar [not null, note: 'EXPIRY_WARNING | POLICE_ESCALATION']
  channel varchar [not null, default: 'SYSTEM', note: 'EMAIL | SMS | SYSTEM']
  message text [not null]
  sent_at timestamp [default: `now()`]
  customer_id varchar [not null]
  extinguisher_id varchar [not null]
}

Table escalations {
  id varchar [primary key, note: 'UUID']
  reason text [not null, note: 'Why police follow-up is required']
  status varchar [not null, default: 'PENDING', note: 'PENDING | REPORTED | RESOLVED']
  reported_at timestamp [note: 'When staff confirmed police were informed']
  resolved_at timestamp [note: 'When case was closed']
  notes text [note: 'Staff notes e.g. police ref number']
  customer_id varchar [not null]
  extinguisher_id varchar [not null]
  created_at timestamp [default: `now()`]
  updated_at timestamp [not null]
}

// Relationships
Ref: fire_extinguishers.customer_id > customers.id [delete: cascade]

Ref: notifications.customer_id > customers.id [delete: cascade]
Ref: notifications.extinguisher_id > fire_extinguishers.id [delete: cascade]

Ref: escalations.customer_id > customers.id [delete: cascade]
Ref: escalations.extinguisher_id > fire_extinguishers.id [delete: cascade]

// Sample data
Records customers(id, full_name, national_id, email, phone, address) {
  'c1111111-1111-1111-1111-111111111111', 'Jean Mukamana', '1199080012345678', 'jean.m@example.com', '+250788100001', '12 KN 4 Ave, Kigali'
