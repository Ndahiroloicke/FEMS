// Fire Extinguisher Management System (FEMS) — Database Model
// DBML — paste into https://dbdiagram.io
// DBMS: PostgreSQL. RESTful monolithic API (NestJS + Prisma).

Enum role { ADMIN INSPECTOR USER }
Enum extinguisher_type { WATER CO2 FOAM DRY_CHEMICAL }
Enum extinguisher_status { ACTIVE EXPIRED NEEDS_MAINTENANCE OUT_OF_SERVICE }
Enum inspection_status { SCHEDULED IN_PROGRESS COMPLETED CANCELLED OVERDUE }
Enum maintenance_condition { GOOD FAIR POOR DAMAGED NEEDS_REPLACEMENT }
Enum notification_type { INSPECTION_SCHEDULED INSPECTION_REMINDER EXPIRY_WARNING MAINTENANCE_LOGGED ACCOUNT }
Enum notification_channel { EMAIL SYSTEM }

Table users {
  id varchar [primary key, note: 'UUID']
  first_name varchar [not null]
  last_name varchar [not null]
  email varchar [unique, not null]
  password_hash varchar [not null, note: 'bcrypt hash']
  role role [not null, default: 'USER']
  is_active boolean [not null, default: true]
  reset_token varchar [note: 'password recovery token']
  reset_token_expires_at timestamp
  created_at timestamp [default: `now()`]
  updated_at timestamp [not null]
}

Table fire_extinguishers {
  id varchar [primary key, note: 'UUID']
  serial_number varchar [unique, not null]
  location varchar [not null]
  type extinguisher_type [not null]
  size varchar [not null, note: 'e.g. 6kg']
  installation_date timestamp [not null]
  expiry_date timestamp [not null]
  status extinguisher_status [not null, default: 'ACTIVE']
  created_at timestamp [default: `now()`]
  updated_at timestamp [not null]
}

Table inspections {
  id varchar [primary key, note: 'UUID']
  extinguisher_id varchar [not null]
  scheduled_by_id varchar [not null, note: 'user who scheduled it']
  inspector_id varchar [note: 'assigned inspector (nullable)']
  scheduled_at timestamp [not null]
  status inspection_status [not null, default: 'SCHEDULED']
  result text
  notes text
  completed_at timestamp
  created_at timestamp [default: `now()`]
  updated_at timestamp [not null]
}

Table maintenance_logs {
  id varchar [primary key, note: 'UUID']
  extinguisher_id varchar [not null]
  inspector_id varchar [not null]
  inspection_id varchar [note: 'optional link to inspection']
  actions_taken text [not null]
  condition_noted maintenance_condition [not null]
  action_date timestamp [not null]
  created_at timestamp [default: `now()`]
}

Table notifications {
  id varchar [primary key, note: 'UUID']
  user_id varchar [not null]
  extinguisher_id varchar [note: 'nullable']
  type notification_type [not null]
  channel notification_channel [not null, default: 'SYSTEM']
  message text [not null]
  is_read boolean [not null, default: false]
  sent_at timestamp [default: `now()`]
}

// Relationships
Ref: inspections.extinguisher_id > fire_extinguishers.id [delete: cascade]
Ref: inspections.scheduled_by_id > users.id
Ref: inspections.inspector_id > users.id

Ref: maintenance_logs.extinguisher_id > fire_extinguishers.id [delete: cascade]
Ref: maintenance_logs.inspector_id > users.id
Ref: maintenance_logs.inspection_id > inspections.id

Ref: notifications.user_id > users.id [delete: cascade]
Ref: notifications.extinguisher_id > fire_extinguishers.id [delete: set null]
