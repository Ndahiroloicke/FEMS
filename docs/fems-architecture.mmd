%% Fire Extinguisher Management System (FEMS) — System Architecture
%% RESTful (monolithic NestJS API — NOT microservices), per SRS.
%% Paste into https://mermaid.live or any Mermaid renderer.

flowchart TB
  subgraph actors["Users / Roles"]
    admin["Admin<br/>(manages system, users, data integrity)"]
    inspector["Inspector<br/>(inspections, maintenance logs, scheduling)"]
    user["User<br/>(views status, schedules inspections)"]
  end

  subgraph client["Frontend — Next.js (React + Tailwind) :3000"]
    auth_ui["Auth pages<br/>Register · Login · Forgot/Reset password"]
    app_ui["App shell (role-aware nav)<br/>Dashboard · Extinguishers · Inspections<br/>Maintenance · Reports · Notifications · Users · Profile"]
    apiclient["API client<br/>JWT in Authorization header"]
    auth_ui --> apiclient
    app_ui --> apiclient
  end

  subgraph api["Backend — NestJS RESTful API  /api  :3001"]
    rest["REST controllers + Swagger /api/docs"]
    subgraph sec["Cross-cutting"]
      guard["JwtAuthGuard + RolesGuard<br/>(@Public / @Roles)"]
      filt["Global exception filter<br/>+ logging interceptor"]
      valid["ValidationPipe · Helmet · CORS · Throttler"]
    end
    mod_auth["Auth module<br/>register/login/logout<br/>forgot/reset password (JWT + bcrypt)"]
    mod_users["Users module<br/>profile · password · admin user mgmt"]
    mod_ext["Extinguishers module (CRUD)"]
    mod_insp["Inspections module<br/>schedule + notify personnel"]
    mod_maint["Maintenance module<br/>log actions / conditions"]
    mod_rep["Reports module<br/>summary · stock · inspection status<br/>expired · maintenance history · CSV/PDF export"]
    mod_notif["Notifications module<br/>in-app + email"]
    cron["Scheduled job (daily)<br/>expiry → EXPIRED · reminders · overdue inspections"]
    rest --> mod_auth & mod_users & mod_ext & mod_insp & mod_maint & mod_rep & mod_notif
    rest --- sec
    cron --> mod_ext
    cron --> mod_notif
    mod_insp --> mod_notif
    mod_maint --> mod_notif
  end

  subgraph data["Data & integrations"]
    prisma["Prisma ORM"]
    pg[("PostgreSQL<br/>users · fire_extinguishers · inspections<br/>maintenance_logs · notifications")]
    smtp["SMTP / Email (nodemailer)"]
    files["PDF (pdfkit) · CSV exports"]
    prisma --> pg
  end

  admin & inspector & user -->|HTTPS| auth_ui
  admin & inspector & user -->|HTTPS| app_ui
  apiclient -->|REST JSON + Bearer JWT| rest

  mod_auth --> prisma
  mod_users --> prisma
  mod_ext --> prisma
  mod_insp --> prisma
  mod_maint --> prisma
  mod_rep --> prisma
  mod_notif --> prisma
  mod_notif --> smtp
  mod_rep --> files
